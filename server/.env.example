# Copy to .env and fill in. .env is git-ignored; this file is committed.
# On a deployed host, set these in the dashboard instead: there is no .env there.

# Local (page 4):    postgresql://postgres:crumbcount1@localhost:5432/crumbcount
# Hosted (page 5):   postgresql://user:pass@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:crumbcount1@localhost:5432/crumbcount

# Comma-separated, no trailing slash, no path. An origin is scheme + host + port.
CORS_ORIGINS=http://localhost:5173

# Set to production on your host. Express and several libraries behave better,
# including not sending stack traces to your users.
NODE_ENV=development

# Require an API key for every non-health route. Set this to a long random value
# in production and keep it out of version control.
API_ACCESS_TOKEN=replace-with-a-long-random-token
REQUIRE_API_AUTH=false

# Number of trusted reverse proxies in front of the API. Leave at 0 unless
# requests can only reach the API through a known proxy.
TRUST_PROXY_HOPS=0

# Do NOT set PORT locally or on the host. The host sets it for you.
