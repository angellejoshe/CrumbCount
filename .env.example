# Only used by compose.yml, if you self-host. Copy to .env and fill in.
# The client and server have their own .env.example files.

POSTGRES_PASSWORD=change-this-to-something-long-and-random
CORS_ORIGINS=https://yourusername.github.io

# Shared access token for the self-hosted API. Do not put a real token in a
# frontend VITE_ variable; the GitHub Pages app uses browser-local storage.
API_ACCESS_TOKEN=replace-with-a-long-random-token
# Set to the number of trusted reverse proxies in front of the API. Keep 0
# unless the API is only reachable through a known proxy.
TRUST_PROXY_HOPS=0
